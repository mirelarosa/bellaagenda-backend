{
  "name": "backend",
  "version": "0.0.0",
  "description": "backend do projeto de conclusão de curso",
  "author": "Evelyn Pedroso Leite, Gabrielly de Oliveira, Luis Felipe Vaz Rodrigues, Matheus Abrahão Martins Alvares, Mirela Rosa de Jesus Trindade, Thalisson Leonardo Martins, Yuri de Jesus Grillo Galvão",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "dev": "node ./bin/www",
    "test": "NODE_ENV=test jest --runInBand --forceExit",
    "migrate": "node scripts/migrate.js",
    "lint": "node --check src/app.js && node --check api/index.js",
    "docker:up": "docker compose up --build",
    "docker:up:detached": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f api"
  },
  "dependencies": {
    "cookie-parser": "~1.4.4",
    "cors": "^2.8.5",
    "debug": "~2.6.9",
    "dotenv": "^16.4.7",
    "express": "~4.16.1",
    "firebase-admin": "^13.0.2",
    "helmet": "^8.0.0",
    "http-errors": "~1.6.3",
    "morgan": "~1.9.1",
    "pg": "^8.13.1",
    "serverless-http": "^3.2.0",
    "stripe": "^17.5.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  }
}
