NODE_ENV=development
PORT=3000

# Local (npm start): postgresql://user:pass@localhost:5432/bellaagenda
# Docker Compose: postgresql://bella:bella@postgres:5432/bellaagenda
DATABASE_URL=postgresql://user:pass@localhost:5432/bellaagenda

CORS_ORIGIN=http://localhost:5173
# Vários origins separados por vírgula. Em development, localhost em qualquer porta também é aceito.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:5173/pagamento/sucesso
STRIPE_CANCEL_URL=http://localhost:5173/pagamento/cancelado
